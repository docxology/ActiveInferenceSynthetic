\@writefile{toc}{\contentsline {section}{\numberline {9}Planning: Policies as Action Sequences}{13}{section.9}\protected@file@percent }
\newlabel{sec:planning}{{9}{13}{Planning: Policies as Action Sequences}{section.9}{}}
\newlabel{sec:planning@cref}{{[section][9][]9}{[1][13][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Planning as expected-free-energy minimization.} The same agent and preferences as sec.~\ref {sec:expected-free-energy} now plan over two-step policies. All four plans are scored exactly (branch enumeration, no sampling): bars are \(G(\mitpi )\), annotated with pragmatic/epistemic splits. \textbf  {Cue-then-bet wins} (\(G = 0.07\)): the first action collects epistemic value (\(+0.37\) nats), and the terminal bet is then placed under the sharpened belief. Betting first (\(G = 0.43\)) pays the same either way and forgoes the information --- under these sharp preferences the \emph  {one-step} optimum is not the \emph  {plan} optimum. Exploration is deferred exploitation. Rendered deterministically by \breaktt {scripts/generate\_policy\_planning\_figure.py} over the tested core in \breaktt {src/policy\_planning.py}.}}{13}{figure.caption.8}\protected@file@percent }
\newlabel{fig:planning}{{7}{13}{\textbf {Planning as expected-free-energy minimization.} The same agent and preferences as sec.~\ref {sec:expected-free-energy} now plan over two-step policies. All four plans are scored exactly (branch enumeration, no sampling): bars are \(G(\pi )\), annotated with pragmatic/epistemic splits. \textbf {Cue-then-bet wins} (\(G = 0.07\)): the first action collects epistemic value (\(+0.37\) nats), and the terminal bet is then placed under the sharpened belief. Betting first (\(G = 0.43\)) pays the same either way and forgoes the information --- under these sharp preferences the \emph {one-step} optimum is not the \emph {plan} optimum. Exploration is deferred exploitation. Rendered deterministically by \protect \breaktt {scripts/generate\_policy\_planning\_figure.py} over the tested core in \protect \breaktt {src/policy\_planning.py}}{figure.caption.8}{}}
\newlabel{fig:planning@cref}{{[figure][7][]7}{[1][13][]13}{}{}{}}
