\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {One landscape, two regimes.} Both panels place the system on the same Gaussian free-energy bowl (grey contours; the black dot marks the mode, where free energy is least). \textbf  {(a) Equilibrium:} the flow is pure gradient descent on free energy, \(f=-\nabla F\) (blue arrows). Detailed balance holds, so trajectories fall to the mode and come to rest with no net probability current. \textbf  {(b) Far-from-equilibrium (NESS):} an antisymmetric \emph  {solenoidal} operator \(Q\) adds a conservative current, \(f=(Q-\mitGamma )\nabla F\) (orange streamlines), that flows along the level sets of \(F\). Free energy is still minimized, but probability mass circulates without end --- the hallmark of living, self-organizing systems. The Free Energy Principle is the descent term; Bayesian mechanics adds the circulation. Internal states \(\mitmu \) infer external states \(\miteta \) across a Markov blanket (sensory \(s\), active \(a\)). Figure rendered deterministically by \breaktt {scripts/generate\_overview\_figure.py} over the tested flow in \breaktt {src/free\_energy\_flow.py}.}}{4}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{4}{\textbf {One landscape, two regimes.} Both panels place the system on the same Gaussian free-energy bowl (grey contours; the black dot marks the mode, where free energy is least). \textbf {(a) Equilibrium:} the flow is pure gradient descent on free energy, \(f=-\nabla F\) (blue arrows). Detailed balance holds, so trajectories fall to the mode and come to rest with no net probability current. \textbf {(b) Far-from-equilibrium (NESS):} an antisymmetric \emph {solenoidal} operator \(Q\) adds a conservative current, \(f=(Q-\Gamma )\nabla F\) (orange streamlines), that flows along the level sets of \(F\). Free energy is still minimized, but probability mass circulates without end --- the hallmark of living, self-organizing systems. The Free Energy Principle is the descent term; Bayesian mechanics adds the circulation. Internal states \(\mu \) infer external states \(\eta \) across a Markov blanket (sensory \(s\), active \(a\)). Figure rendered deterministically by \protect \breaktt {scripts/generate\_overview\_figure.py} over the tested flow in \protect \breaktt {src/free\_energy\_flow.py}}{figure.caption.2}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][3][]4}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Perception as Inference}{5}{section.3}\protected@file@percent }
\newlabel{sec:generative-model}{{3}{5}{Perception as Inference}{section.3}{}}
\newlabel{sec:generative-model@cref}{{[section][3][]3}{[1][5][]5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Perception as free-energy minimization.} A two-state generative model (prior \(p(x)=(0.60,0.40)\); likelihood favouring \(x_0\) for the observed \(s\)). \textbf  {(a)} From a uniform starting belief, gradient descent on variational free energy drives the belief over hidden states to the exact Bayesian posterior \(p(x\mid s)\) (orange), passing through intermediate beliefs (blue) on the way. \textbf  {(b)} Along the same descent the free energy \(F[q_t]\) falls monotonically to the surprise \(-\ln p(s)\) (dashed) that it bounds; the shaded gap is exactly \(\mathrm {KL}[q_t\Vert p(x\mid s)]\), the belief's error, which closes as inference completes. Minimizing free energy is Bayesian updating. Rendered deterministically by \breaktt {scripts/generate\_belief\_update\_figure.py} over the tested core in \breaktt {src/generative\_model.py}.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:belief}{{2}{5}{\textbf {Perception as free-energy minimization.} A two-state generative model (prior \(p(x)=(0.60,0.40)\); likelihood favouring \(x_0\) for the observed \(s\)). \textbf {(a)} From a uniform starting belief, gradient descent on variational free energy drives the belief over hidden states to the exact Bayesian posterior \(p(x\mid s)\) (orange), passing through intermediate beliefs (blue) on the way. \textbf {(b)} Along the same descent the free energy \(F[q_t]\) falls monotonically to the surprise \(-\ln p(s)\) (dashed) that it bounds; the shaded gap is exactly \(\mathrm {KL}[q_t\Vert p(x\mid s)]\), the belief's error, which closes as inference completes. Minimizing free energy is Bayesian updating. Rendered deterministically by \protect \breaktt {scripts/generate\_belief\_update\_figure.py} over the tested core in \protect \breaktt {src/generative\_model.py}}{figure.caption.3}{}}
\newlabel{fig:belief@cref}{{[figure][2][]2}{[1][5][]5}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Worked Regimes: Equilibrium and Non-Equilibrium}{6}{section.4}\protected@file@percent }
\newlabel{sec:worked-regimes}{{4}{6}{Worked Regimes: Equilibrium and Non-Equilibrium}{section.4}{}}
\newlabel{sec:worked-regimes@cref}{{[section][4][]4}{[1][6][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Worked trajectories over one landscape.} Both panels integrate the Bayesian-mechanics flow \(f=(Q-\mitGamma )\nabla F\) from the same starting point (coloured dot) over the same Gaussian free-energy bowl (grey contours; black dot marks the mode). \textbf  {(a) Equilibrium} (\(Q=0\)): pure descent falls radially to the mode and rests --- free energy monotonically decreasing, rotation rate \(\approx 0\) turns/time. \textbf  {(b) NESS} (\(Q\neq 0\)): the same descent plus a solenoidal term spirals inward at a constant rate \(\approx -0.38\) turns/time (\(\approx -4.58\) turns over the window \(T=12\)) while free energy still decreases monotonically. The nonzero rotation rate witnesses the broken detailed balance that generates the steady-state probability current --- the marker distinguishing far-from-equilibrium life from equilibrium rest. Rendered deterministically by \breaktt {scripts/generate\_trajectory\_figure.py} over the tested cores in \breaktt {src/trajectories.py} and \breaktt {src/free\_energy\_flow.py}.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:trajectories}{{3}{7}{\textbf {Worked trajectories over one landscape.} Both panels integrate the Bayesian-mechanics flow \(f=(Q-\Gamma )\nabla F\) from the same starting point (coloured dot) over the same Gaussian free-energy bowl (grey contours; black dot marks the mode). \textbf {(a) Equilibrium} (\(Q=0\)): pure descent falls radially to the mode and rests --- free energy monotonically decreasing, rotation rate \(\approx 0\) turns/time. \textbf {(b) NESS} (\(Q\neq 0\)): the same descent plus a solenoidal term spirals inward at a constant rate \(\approx -0.38\) turns/time (\(\approx -4.58\) turns over the window \(T=12\)) while free energy still decreases monotonically. The nonzero rotation rate witnesses the broken detailed balance that generates the steady-state probability current --- the marker distinguishing far-from-equilibrium life from equilibrium rest. Rendered deterministically by \protect \breaktt {scripts/generate\_trajectory\_figure.py} over the tested cores in \protect \breaktt {src/trajectories.py} and \protect \breaktt {src/free\_energy\_flow.py}}{fi