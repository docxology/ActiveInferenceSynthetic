\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {One landscape, two regimes.} Both panels place the system on the same Gaussian free-energy bowl (grey contours; the black dot marks the mode, where free energy is least). \textbf  {(a) Equilibrium:} the flow is pure gradient descent on free energy, \(f=-\nabla F\) (blue arrows). Detailed balance holds, so trajectories fall to the mode and come to rest with no net probability current. \textbf  {(b) Far-from-equilibrium (NESS):} an antisymmetric \emph  {solenoidal} operator \(Q\) adds a conservative current, \(f=(Q-\mitGamma )\nabla F\) (orange streamlines), that flows along the level sets of \(F\). Free energy is still minimized, but probability mass circulates without end --- the hallmark of living, self-organizing systems. The Free Energy Principle is the descent term; Bayesian mechanics adds the circulation. Internal states \(\mitmu \) infer external states \(\miteta \) across a Markov blanket (sensory \(s\), active \(a\)). Figure rendered deterministically by \breaktt {scripts/generate\_overview\_figure.py} over the tested flow in \breaktt {src/free\_energy\_flow.py}.}}{4}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{4}{\textbf {One landscape, two regimes.} Both panels place the system on the same Gaussian free-energy bowl (grey contours; the black dot marks the mode, where free energy is least). \textbf {(a) Equilibrium:} the flow is pure gradient descent on free energy, \(f=-\nabla F\) (blue arrows). Detailed balance holds, so trajectories fall to the mode and come to rest with no net probability current. \textbf {(b) Far-from-equilibrium (NESS):} an antisymmetric \emph {solenoidal} operator \(Q\) adds a conservative current, \(f=(Q-\Gamma )\nabla F\) (orange streamlines), that flows along the level sets of \(F\). Free energy is still minimized, but probability mass circulates without end --- the hallmark of living, self-organizing systems. The Free Energy Principle is the descent term; Bayesian mechanics adds the circulation. Internal states \(\mu \) infer external states \(\eta \) across a Markov blanket (sensory \(s\), active \(a\)). Figure rendered deterministically by \protect \breaktt {scripts/generate\_overview\_figure.py} over the tested flow in \protect \breaktt {src/free\_energy\_flow.py}}{figure.caption.2}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][3][]4}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Perception as Inference}{5}{section.3}\protected@file@percent }
\newlabel{sec:generative-model}{{3}{5}{Perception as Inference}{section.3}{}}
\newlabel{sec:generative-model@cref}{{[section][3][]3}{[1][5][]5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Perception as free-energy minimization.} A two-state generative model (prior \(p(x)=(0.60,0.40)\); likelihood favouring \(x_0\) for the observed \(s\)). \textbf  {(a)} From a uniform starting belief, gradient descent on variational free energy drives the belief over hidden states to the exact Bayesian posterior \(p(x\mid s)\) (orange), passing through intermediate beliefs (blue) on the way. \textbf  {(b)} Along the same descent the free energy \(F[q_t]\) falls monotonically to the surprise \(-\ln p(s)\) (dashed) that it bounds; the shaded gap is exactly \(\mathrm {KL}[q_t\Vert p(x\mid s)]\), the belief's error, which closes as inference completes. Minimizing free energy is Bayesian updating. Rendered deterministically by \breaktt {scripts/generate\_belief\_update\_figure.py} over the tested core in \breaktt {src/generative\_model.py}.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:belief}{{2}{5}{\textbf {Perception as free-energy minimization.} A two-state generative model (prior \(p(x)=(0.60,0.40)\); likelihood favouring \(x_0\) for the observed \(s\)). \textbf {(a)} From a uniform starting belief, gradient descent on variational free energy drives the belief over hidden states to the exact Bayesian posterior \(p(x\mid s)\) (orange), passing through intermediate beliefs (blue) on the way. \textbf {(b)} Along the same descent the free energy \(F[q_t]\) falls monotonically to the surprise \(-\ln p(s)\) (dashed) that it bounds; the shaded gap is exactly \(\mathrm {KL}[q_t\Vert p(x\mid s)]\), the belief's error, which closes as inference completes. Minimizing free energy is Bayesian updating. Rendered deterministically by \protect \breaktt {scripts/generate\_belief\_update\_figure.py} over the tested core in \protect \breaktt {src/generative\_model.py}}{figure.caption.3}{}}
\newlabel{fig:belief@cref}{{[figure][2][]2}{[1][5][]5}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Worked Regimes: Equilibrium and Non-Equilibrium}{6}{section.4}\protected@file@percent }
\newlabel{sec:worked-regimes}{{4}{6}{Worked Regimes: Equilibrium and Non-Equilibrium}{section.4}{}}
\newlabel{sec:worked-regimes@cref}{{[section][4][]4}{[1][6][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Worked trajectories over one landscape.} Both panels integrate the Bayesian-mechanics flow \(f=(Q-\mitGamma )\nabla F\) from the same starting point (coloured dot) over the same Gaussian free-energy bowl (grey contours; black dot marks the mode). \textbf  {(a) Equilibrium} (\(Q=0\)): pure descent falls radially to the mode and rests --- free energy monotonically decreasing, rotation rate \(\approx 0\) turns/time. \textbf  {(b) NESS} (\(Q\neq 0\)): the same descent plus a solenoidal term spirals inward at a constant rate \(\approx -0.38\) turns/time (\(\approx -4.58\) turns over the window \(T=12\)) while free energy still decreases monotonically. The nonzero rotation rate witnesses the broken detailed balance that generates the steady-state probability current --- the marker distinguishing far-from-equilibrium life from equilibrium rest. Rendered deterministically by \breaktt {scripts/generate\_trajectory\_figure.py} over the tested cores in \breaktt {src/trajectories.py} and \breaktt {src/free\_energy\_flow.py}.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:trajectories}{{3}{7}{\textbf {Worked trajectories over one landscape.} Both panels integrate the Bayesian-mechanics flow \(f=(Q-\Gamma )\nabla F\) from the same starting point (coloured dot) over the same Gaussian free-energy bowl (grey contours; black dot marks the mode). \textbf {(a) Equilibrium} (\(Q=0\)): pure descent falls radially to the mode and rests --- free energy monotonically decreasing, rotation rate \(\approx 0\) turns/time. \textbf {(b) NESS} (\(Q\neq 0\)): the same descent plus a solenoidal term spirals inward at a constant rate \(\approx -0.38\) turns/time (\(\approx -4.58\) turns over the window \(T=12\)) while free energy still decreases monotonically. The nonzero rotation rate witnesses the broken detailed balance that generates the steady-state probability current --- the marker distinguishing far-from-equilibrium life from equilibrium rest. Rendered deterministically by \protect \breaktt {scripts/generate\_trajectory\_figure.py} over the tested cores in \protect \breaktt {src/trajectories.py} and \protect \breaktt {src/free\_energy\_flow.py}}{figure.caption.4}{}}
\newlabel{fig:trajectories@cref}{{[figure][3][]3}{[1][6][]7}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Action: Variational vs Expected Free Energy}{8}{section.5}\protected@file@percent }
\newlabel{sec:expected-free-energy}{{5}{8}{Action: Variational vs Expected Free Energy}{section.5}{}}
\newlabel{sec:expected-free-energy@cref}{{[section][5][]5}{[1][8][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {One rule yields explore and exploit.} An agent uncertain between two contexts (\(q(s)=(0.50,0.50)\)) chooses between an informative ``cue'' (epistemic value \(+0.37\), preference-neutral) and a rewarding but uninformative ``bet'' (epistemic value \(0\)). Bars are expected free energy \(G\) per action (lower is chosen); each is annotated with its pragmatic/epistemic split. \textbf  {(a) Flat preferences:} the epistemic term dominates, so the agent explores (cue, \(G=0.33\)). \textbf  {(b) Sharp preferences:} the pragmatic term dominates, so the same \(\arg \min G\) rule exploits (bet, \(G=0.43\)). A single rule; the balance of \(G\)'s two terms --- not a hand-coded switch --- is what turns over between the panels. Rendered deterministically by \breaktt {scripts/generate\_efe\_figure.py} over the tested core in \breaktt {src/expected\_free\_energy.py}.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:efe}{{4}{8}{\textbf {One rule yields explore and exploit.} An agent uncertain between two contexts (\(q(s)=(0.50,0.50)\)) chooses between an informative ``cue'' (epistemic value \(+0.37\), preference-neutral) and a rewarding but uninformative ``bet'' (epistemic value \(0\)). Bars are expected free energy \(G\) per action (lower is chosen); each is annotated with its pragmatic/epistemic split. \textbf {(a) Flat preferences:} the epistemic term dominates, so the agent explores (cue, \(G=0.33\)). \textbf {(b) Sharp preferences:} the pragmatic term dominates, so the same \(\arg \min G\) rule exploits (bet, \(G=0.43\)). A single rule; the balance of \(G\)'s two terms --- not a hand-coded switch --- is what turns over between the panels. Rendered deterministically by \protect \breaktt {scripts/generate\_efe\_figure.py} over the tested core in \protect \breaktt {src/expected\_free\_energy.py}}{figure.caption.5}{}}
\newlabel{fig:efe@cref}{{[figure][4][]4}{[1][8][]8}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}The Markov Blanket}{9}{section.6}\protected@file@percent }
\newlabel{sec:markov-blanket}{{6}{9}{The Markov Blanket}{section.6}{}}
\newlabel{sec:markov-blanket@cref}{{[section][6][]6}{[1][9][]9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Marginal dependence, conditional independence.} A jointly Gaussian world over external \(\miteta \), sensory \(s\), active \(a\), internal \(\mitmu \), built with a zero \(\miteta \)--\(\mitmu \) precision block. \textbf  {(a) Marginal correlation:} \(\miteta \) and \(\mitmu \) are correlated (\(0.19\), highlighted) --- they are statistically coupled through the blanket. \textbf  {(b) Precision (inverse covariance):} the \(\miteta \)--\(\mitmu \) entry is exactly \(0\), which in a Gaussian \emph  {is} conditional independence given the other variables --- so \(\miteta \perp \mitmu \mid \{s,a\}\) and the partial correlation given the blanket is \(0\). The sensory and active states screen the internal states from the external world. Rendered deterministically by \breaktt {scripts/generate\_markov\_blanket\_figure.py} over the tested core in \breaktt {src/markov\_blanket.py}.}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:blanket}{{5}{10}{\textbf {Marginal dependence, conditional independence.} A jointly Gaussian world over external \(\eta \), sensory \(s\), active \(a\), internal \(\mu \), built with a zero \(\eta \)--\(\mu \) precision block. \textbf {(a) Marginal correlation:} \(\eta \) and \(\mu \) are correlated (\(0.19\), highlighted) --- they are statistically coupled through the blanket. \textbf {(b) Precision (inverse covariance):} the \(\eta \)--\(\mu \) entry is exactly \(0\), which in a Gaussian \emph {is} conditional independence given the other variables --- so \(\eta \perp \mu \mid \{s,a\}\) and the partial correlation given the blanket is \(0\). The sensory and active states screen the internal states from the external world. Rendered deterministically by \protect \breaktt {scripts/generate\_markov\_blanket\_figure.py} over the tested core in \protect \breaktt {src/markov\_blanket.py}}{figure.caption.6}{}}
\newlabel{fig:blanket@cref}{{[figure][5][]5}{[1][9][]10}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}The Steady State, Quantified}{10}{section.7}\protected@file@percent }
\newlabel{sec:steady-state}{{7}{10}{The Steady State, Quantified}{section.7}{}}
\newlabel{sec:steady-state@cref}{{[section][7][]7}{[1][10][]10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Probability current and entropy production.} Both panels place the same stationary Gaussian density (grey contours) under the Bayesian-mechanics diffusion. \textbf  {(a) Equilibrium} (\(Q=0\)): the steady-state probability current is zero everywhere and the entropy-production rate is \(\mitsigma =0\) --- detailed balance. \textbf  {(b) NESS} (\(Q\neq 0\)): a divergence-free current \(j=(QPx)\mitrho \) circulates around the mode (orange arrows), sustained at an entropy-production rate \(\mitsigma =2\mitomega ^2\mitPi /\mitgamma >0\) (here \(\mitsigma \approx 11.5\) nats/time). The current vanishes at the mode (where \(QPx=0\)) and in the tails (where \(\mitrho \to 0\)), peaking on an annulus between. Rendered deterministically by \breaktt {scripts/generate\_steady\_state\_figure.py} over the tested core in \breaktt {src/steady\_state.py}.}}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:steady}{{6}{11}{\textbf {Probability current and entropy production.} Both panels place the same stationary Gaussian density (grey contours) under the Bayesian-mechanics diffusion. \textbf {(a) Equilibrium} (\(Q=0\)): the steady-state probability current is zero everywhere and the entropy-production rate is \(\sigma =0\) --- detailed balance. \textbf {(b) NESS} (\(Q\neq 0\)): a divergence-free current \(j=(QPx)\rho \) circulates around the mode (orange arrows), sustained at an entropy-production rate \(\sigma =2\omega ^2\Pi /\gamma >0\) (here \(\sigma \approx 11.5\) nats/time). The current vanishes at the mode (where \(QPx=0\)) and in the tails (where \(\rho \to 0\)), peaking on an annulus between. Rendered deterministically by \protect \breaktt {scripts/generate\_steady\_state\_figure.py} over the tested core in \protect \breaktt {src/steady\_state.py}}{figure.caption.7}{}}
\newlabel{fig:steady@cref}{{[figure][6][]6}{[1][11][]11}{}{}{}}
